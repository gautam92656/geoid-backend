enum HeaderFooterTemplateKind {
  header
  footer

  @@map("header_footer_template_kind")
}

enum HeaderFooterReportType {
  borelog
  corelog

  @@map("header_footer_report_type")
}

model HeaderFooterTemplate {
  id         Int                       @id @default(autoincrement())
  userId     Int                       @map("user_id")
  name       String                    @db.VarChar(200)
  kind       HeaderFooterTemplateKind
  reportType HeaderFooterReportType?   @map("report_type")
  content    Json                      @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, deletedAt])
  @@map("header_footer_templates")
}
