/// Per-configuration customized origin options for a module (copied from common templates on first use).
model UserOriginOption {
  id                         Int      @id @default(autoincrement())
  userId                     Int      @map("user_id")
  logConfigurationId         Int      @map("log_configuration_id")
  moduleSlug                 String   @map("module_slug") @db.VarChar(100)
  /// Stable key used as the client-facing option id.
  optionKey                  String   @map("option_key") @db.VarChar(100)
  /// Template row this option was copied from (null for user-created options).
  sourceTemplateId           Int?     @map("source_template_id")
  name                       String   @db.VarChar(200)
  nameInDescription          String?  @map("name_in_description") @db.VarChar(200)
  codeInDescription          String?  @map("code_in_description") @db.VarChar(100)
  classificationCodeOverride Boolean  @default(false) @map("classification_code_override")
  /// Soil | Rock | Non-Soil
  type                       String   @default("Soil") @db.VarChar(50)
  color                      String?  @db.VarChar(100)
  applyColorToPdf            Boolean  @default(false) @map("apply_color_to_pdf")
  overrideGraphic            Boolean  @default(false) @map("override_graphic")
  splitGraphic               Boolean  @default(false) @map("split_graphic")
  graphic                    String?  @db.VarChar(255)
  sortOrder                  Int      @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  logConfiguration LogConfiguration @relation(fields: [logConfigurationId], references: [id], onDelete: Cascade)

  @@unique([logConfigurationId, moduleSlug, optionKey], map: "user_origins_config_module_key_key")
  @@index([userId, logConfigurationId, moduleSlug, sortOrder], map: "user_origins_user_config_module_idx")
  @@map("user_origin_options")
}
