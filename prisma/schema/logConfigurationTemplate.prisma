enum LogConfigurationTemplateDiscipline {
  Geotechnical
  Environmental

  @@map("log_configuration_template_discipline")
}

model LogConfigurationTemplate {
  id          Int                                  @id @default(autoincrement())
  slug        String                               @unique @db.VarChar(100)
  name        String                               @db.VarChar(500)
  description String
  region      String                               @db.VarChar(10)
  disciplines LogConfigurationTemplateDiscipline[]
  isAvailable Boolean                              @default(true) @map("is_available")
  sortOrder   Int                                  @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("log_configuration_templates")
}
