/// Common Log Remarks quick-note catalog defaults.
model RemarksQuickNoteTemplate {
  id           Int    @id @default(autoincrement())
  moduleSlug   String @map("module_slug") @db.VarChar(100)
  optionKey    String @map("option_key") @db.VarChar(100)
  name         String @db.VarChar(200)
  remarkTypeId String @map("remark_type_id") @db.VarChar(100)
  sortOrder    Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([moduleSlug, optionKey], map: "remarks_qn_tpl_module_key")
  @@index([moduleSlug, sortOrder], map: "remarks_qn_tpl_module_sort_idx")
  @@map("remarks_quick_note_templates")
}
