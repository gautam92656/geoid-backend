model LogSubsurfaceLayer {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  projectId      Int       @map("project_id")
  logId          Int       @map("log_id")
  depth          String    @db.VarChar(50)
  classification String    @default("") @db.VarChar(100)
  origin         String    @default("") @db.VarChar(100)
  description    String    @default("")
  consistency    String    @default("") @db.VarChar(100)
  moisture       String    @default("") @db.VarChar(100)
  remarks        String    @default("")
  hatch          String    @default("empty") @db.VarChar(50)
  values         Json      @default("{}")
  sortOrder      Int       @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  log     Log     @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId, deletedAt, sortOrder])
  @@index([projectId, logId])
  @@map("log_subsurface_layers")
}
