/// Common Log Remarks remark-type catalog defaults.
model RemarkTypeTemplate {
  id           Int     @id @default(autoincrement())
  moduleSlug   String  @map("module_slug") @db.VarChar(100)
  optionKey    String  @map("option_key") @db.VarChar(100)
  name         String  @db.VarChar(200)
  tablogsAlias String? @map("tablogs_alias") @db.VarChar(100)
  sortOrder    Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([moduleSlug, optionKey], map: "remark_type_tpl_module_key")
  @@index([moduleSlug, sortOrder], map: "remark_type_tpl_module_sort_idx")
  @@map("remark_type_templates")
}
