model LogInsituTest {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  projectId      Int       @map("project_id")
  logId          Int       @map("log_id")
  /// Optional link when this test was created from a sample.
  sampleId       Int?      @map("sample_id")
  depthFrom      String    @map("depth_from") @db.VarChar(50)
  depthTo        String    @default("") @map("depth_to") @db.VarChar(50)
  testTypeId     String    @map("test_type_id") @db.VarChar(100)
  testTypeName   String    @map("test_type_name") @db.VarChar(200)
  results        String    @default("")
  comments       String    @default("")
  /// Type-specific result fields (interval, readings, blows, etc.)
  resultValues   Json      @default("{}") @map("result_values")
  sortOrder      Int       @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user    User       @relation(fields: [userId], references: [id])
  project Project    @relation(fields: [projectId], references: [id])
  log     Log        @relation(fields: [logId], references: [id], onDelete: Cascade)
  sample  LogSample? @relation(fields: [sampleId], references: [id], onDelete: SetNull)

  @@index([logId, deletedAt, sortOrder])
  @@index([projectId, logId])
  @@index([sampleId, deletedAt])
  @@map("log_insitu_tests")
}
