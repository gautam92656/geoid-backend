model LogWellProbe {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  projectId     Int       @map("project_id")
  logId         Int       @map("log_id")
  wellId        String    @default("") @map("well_id") @db.VarChar(100)
  wellIdLabel   String    @default("") @map("well_id_label") @db.VarChar(200)
  probeTypeId   String    @map("probe_type_id") @db.VarChar(100)
  probeTypeName String    @map("probe_type_name") @db.VarChar(200)
  depthFrom     String    @default("") @map("depth_from") @db.VarChar(50)
  depthTo       String    @default("") @map("depth_to") @db.VarChar(50)
  comments      String    @default("")
  sortOrder     Int       @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  log     Log     @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId, deletedAt, sortOrder])
  @@index([projectId, logId])
  @@map("log_well_probes")
}
