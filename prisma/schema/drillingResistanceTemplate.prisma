/// Common Drilling Observations resistance-type catalog defaults.
/// Users get a per-log-configuration copy in `user_drilling_resistances`.
model DrillingResistanceTemplate {
  id           Int     @id @default(autoincrement())
  moduleSlug   String  @map("module_slug") @db.VarChar(100)
  optionKey    String  @map("option_key") @db.VarChar(100)
  name         String  @db.VarChar(200)
  tablogsAlias String? @map("tablogs_alias") @db.VarChar(100)
  sortOrder    Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([moduleSlug, optionKey], map: "drilling_resist_tpl_module_key")
  @@index([moduleSlug, sortOrder], map: "drilling_resist_tpl_module_sort_idx")
  @@map("drilling_resistance_templates")
}
