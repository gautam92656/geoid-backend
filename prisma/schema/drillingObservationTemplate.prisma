/// Common Drilling Observations observation catalog defaults.
/// Users get a per-log-configuration copy in `user_drilling_observations`.
model DrillingObservationTemplate {
  id                          Int     @id @default(autoincrement())
  moduleSlug                  String  @map("module_slug") @db.VarChar(100)
  optionKey                   String  @map("option_key") @db.VarChar(100)
  name                        String  @db.VarChar(200)
  tablogsAlias                String? @map("tablogs_alias") @db.VarChar(100)
  graphic                     String? @db.VarChar(255)
  depthRequired               Boolean @default(false) @map("depth_required")
  observationDateTimeRequired Boolean @default(false) @map("observation_date_time_required")
  isDepthOfCasing             Boolean @default(false) @map("is_depth_of_casing")
  isDepthToWater              Boolean @default(false) @map("is_depth_to_water")
  sortOrder                   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([moduleSlug, optionKey], map: "drilling_obs_tpl_module_key")
  @@index([moduleSlug, sortOrder], map: "drilling_obs_tpl_module_sort_idx")
  @@map("drilling_observation_templates")
}
