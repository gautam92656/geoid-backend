model LogDrillingMethod {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  projectId          Int       @map("project_id")
  logId              Int       @map("log_id")
  depthFrom          String    @default("") @map("depth_from") @db.VarChar(50)
  depthTo            String    @default("") @map("depth_to") @db.VarChar(50)
  drillingMethodId   String    @map("drilling_method_id") @db.VarChar(100)
  drillingMethodName String    @map("drilling_method_name") @db.VarChar(200)
  windowedWindowless String    @default("") @map("windowed_windowless") @db.VarChar(20)
  diameter           String    @default("") @db.VarChar(50)
  recovery           String    @default("") @db.VarChar(50)
  waterAdded         String    @default("") @map("water_added") @db.VarChar(50)
  comments           String    @default("")
  sortOrder          Int       @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  log     Log     @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId, deletedAt, sortOrder])
  @@index([projectId, logId])
  @@map("log_drilling_methods")
}
