/// Per-configuration drilling observations (copied from common templates on first use).
model UserDrillingObservation {
  id                          Int     @id @default(autoincrement())
  userId                      Int     @map("user_id")
  logConfigurationId          Int     @map("log_configuration_id")
  moduleSlug                  String  @map("module_slug") @db.VarChar(100)
  optionKey                   String  @map("option_key") @db.VarChar(100)
  sourceTemplateId            Int?    @map("source_template_id")
  name                        String  @db.VarChar(200)
  tablogsAlias                String? @map("tablogs_alias") @db.VarChar(100)
  graphic                     String? @db.VarChar(255)
  depthRequired               Boolean @default(false) @map("depth_required")
  observationDateTimeRequired Boolean @default(false) @map("observation_date_time_required")
  isDepthOfCasing             Boolean @default(false) @map("is_depth_of_casing")
  isDepthToWater              Boolean @default(false) @map("is_depth_to_water")
  sortOrder                   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  logConfiguration LogConfiguration @relation(fields: [logConfigurationId], references: [id], onDelete: Cascade)

  @@unique([logConfigurationId, moduleSlug, optionKey], map: "user_drilling_obs_config_key")
  @@index([userId, logConfigurationId, moduleSlug, sortOrder], map: "user_drilling_obs_user_config_idx")
  @@map("user_drilling_observations")
}
