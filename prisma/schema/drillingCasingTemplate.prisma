/// Common Drilling Observations casing-type catalog defaults.
/// Users get a per-log-configuration copy in `user_drilling_casings`.
model DrillingCasingTemplate {
  id           Int     @id @default(autoincrement())
  moduleSlug   String  @map("module_slug") @db.VarChar(100)
  optionKey    String  @map("option_key") @db.VarChar(100)
  name         String  @db.VarChar(200)
  tablogsAlias String? @map("tablogs_alias") @db.VarChar(100)
  graphic      String? @db.VarChar(255)
  startGraphic String? @map("start_graphic") @db.VarChar(255)
  endGraphic   String? @map("end_graphic") @db.VarChar(255)
  sortOrder    Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([moduleSlug, optionKey], map: "drilling_casing_tpl_module_key")
  @@index([moduleSlug, sortOrder], map: "drilling_casing_tpl_module_sort_idx")
  @@map("drilling_casing_templates")
}
